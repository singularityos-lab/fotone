+extern "C" WEBKIT_API void webkit_fotone_web_view_set_suspended(WebKitWebView* webView, gboolean suspended)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_VIEW(webView));
+    auto& page = getPage(webView);
+    if (suspended)
+        page.suspend([](bool) { });
+    else
+        page.resume([](bool) { });
+}

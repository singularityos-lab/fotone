+WebCore::Color PageClientImpl::accentColor()
+{
+#if ENABLE(WPE_PLATFORM)
+    if (auto* view = m_view.wpeView()) {
+        const char* value = wpe_settings_get_string(wpe_display_get_settings(wpe_view_get_display(view)), WPE_SETTING_ACCENT_COLOR, nullptr);
+        if (value && strlen(value) == 7 && value[0] == '#') {
+            char* end = nullptr;
+            unsigned long rgb = strtoul(value + 1, &end, 16);
+            if (end == value + 7)
+                return WebCore::SRGBA<uint8_t> { static_cast<uint8_t>(rgb >> 16), static_cast<uint8_t>(rgb >> 8), static_cast<uint8_t>(rgb), 255 };
+        }
+    }
+#endif
+    return { };
+}

+void WebPageProxy::accentColorDidChange()
+{
+    RefPtr pageClient = this->pageClient();
+    if (!hasRunningProcess() || !pageClient)
+        return;
+
+    legacyMainFrameProcess().send(Messages::WebPage::SetAccentColor(pageClient->accentColor()), webPageIDInMainFrameProcess());
+}

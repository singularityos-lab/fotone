+++ b/Source/WebKit/UIProcess/WebAuthentication/sinty/HidService.cpp
@@ -0,0 +1,67 @@
+#include "config.h"
+#include "HidService.h"
+
+#if ENABLE(WEB_AUTHN)
+
+#include "CtapHidDriver.h"
+
+extern "C" {
+__attribute__((weak)) int fotone_hid_scan(void (*)(void*, const char*), void*);
+}
+
+namespace WebKit {
+
+Ref<HidService> HidService::create(AuthenticatorTransportServiceObserver& observer)
+{
+    return adoptRef(*new HidService(observer));
+}
+
+HidService::HidService(AuthenticatorTransportServiceObserver& observer)
+    : FidoService(observer)
+    , m_scanTimer(RunLoop::mainSingleton(), "HidService::ScanTimer"_s, this, &HidService::scan)
+{
+}
+
+HidService::~HidService() = default;
+
+void HidService::startDiscoveryInternal()
+{
+    platformStartDiscovery();
+}
+
+void HidService::platformStartDiscovery()
+{
+    scan();
+    m_scanTimer.startRepeating(1_s);
+}
+
+void HidService::scan()
+{
+    if (!fotone_hid_scan)
+        return;
+    HashSet<String> found;
+    fotone_hid_scan([](void* data, const char* path) {
+        static_cast<HashSet<String>*>(data)->add(String::fromUTF8(path));
+    }, &found);
+    for (auto& path : found) {
+        if (m_present.contains(path))
+            continue;
+        FotoneHidDevice device { path.utf8() };
+        deviceAdded(&device);
+    }
+    m_present = WTF::move(found);
+}
+
+Ref<HidConnection> HidService::createHidConnection(IOHIDDeviceRef device) const
+{
+    return HidConnection::create(device);
+}
+
+void HidService::deviceAdded(IOHIDDeviceRef device)
+{
+    getInfo(CtapHidDriver::create(createHidConnection(device)));
+}
+
+}
+
+#endif

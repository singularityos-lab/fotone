--- a/Source/WebKit/UIProcess/WebAuthentication/sinty/HidConnection.cpp
+++ b/Source/WebKit/UIProcess/WebAuthentication/sinty/HidConnection.cpp
@@ -0,0 +1,132 @@
+#include "config.h"
+#include "HidConnection.h"
+
+#if ENABLE(WEB_AUTHN)
+
+#include <WebCore/FidoConstants.h>
+#include <array>
+#include <glib-unix.h>
+#include <wtf/RunLoop.h>
+
+extern "C" {
+__attribute__((weak)) int fotone_hid_open(const char*);
+__attribute__((weak)) void fotone_hid_close(int);
+__attribute__((weak)) int fotone_hid_write(int, const uint8_t*, size_t);
+__attribute__((weak)) ssize_t fotone_hid_read(int, uint8_t*, size_t);
+}
+
+namespace WebKit {
+using namespace fido;
+
+Ref<HidConnection> HidConnection::create(IOHIDDeviceRef device)
+{
+    return adoptRef(*new HidConnection(device));
+}
+
+HidConnection::HidConnection(IOHIDDeviceRef device)
+    : m_path(device ? device->path : CString())
+{
+}
+
+HidConnection::~HidConnection()
+{
+    if (m_source)
+        g_source_destroy(m_source.get());
+    if (m_fd >= 0 && fotone_hid_close)
+        fotone_hid_close(m_fd);
+}
+
+void HidConnection::initialize()
+{
+    if (fotone_hid_open && !m_path.isNull())
+        m_fd = fotone_hid_open(m_path.data());
+    if (m_fd >= 0) {
+        m_source = adoptGRef(g_unix_fd_source_new(m_fd, static_cast<GIOCondition>(G_IO_IN | G_IO_ERR | G_IO_HUP)));
+        g_source_set_callback(m_source.get(), reinterpret_cast<GSourceFunc>(+[](int, GIOCondition condition, gpointer data) -> gboolean {
+            Ref connection = *static_cast<HidConnection*>(data);
+            if (condition & (G_IO_ERR | G_IO_HUP)) {
+                connection->m_source = nullptr;
+                connection->receiveReport({ });
+                return G_SOURCE_REMOVE;
+            }
+            connection->readReports();
+            return G_SOURCE_CONTINUE;
+        }), this, nullptr);
+        g_source_attach(m_source.get(), RunLoop::mainSingleton().mainContext());
+    }
+    m_isInitialized = true;
+}
+
+void HidConnection::terminate()
+{
+    if (m_source) {
+        g_source_destroy(m_source.get());
+        m_source = nullptr;
+    }
+    if (m_fd >= 0 && fotone_hid_close)
+        fotone_hid_close(m_fd);
+    m_fd = -1;
+    m_isInitialized = false;
+}
+
+void HidConnection::readReports()
+{
+    std::array<uint8_t, kHidMaxPacketSize> report;
+    while (m_fd >= 0) {
+        auto length = fotone_hid_read(m_fd, report.data(), report.size());
+        if (length <= 0)
+            return;
+        receiveReport(Vector<uint8_t> { std::span { report }.first(static_cast<size_t>(length)) });
+    }
+}
+
+auto HidConnection::sendSync(const Vector<uint8_t>& data) -> DataSent
+{
+    ASSERT(m_isInitialized);
+    if (m_fd < 0 || !fotone_hid_write)
+        return DataSent::No;
+    return fotone_hid_write(m_fd, data.span().data(), data.size()) ? DataSent::Yes : DataSent::No;
+}
+
+void HidConnection::send(Vector<uint8_t>&& data, DataSentCallback&& callback)
+{
+    ASSERT(m_isInitialized);
+    auto sent = sendSync(data);
+    RunLoop::mainSingleton().dispatch([callback = WTF::move(callback), sent]() mutable {
+        callback(sent);
+    });
+}
+
+void HidConnection::registerDataReceivedCallback(DataReceivedCallback&& callback)
+{
+    ASSERT(m_isInitialized);
+    ASSERT(!m_inputCallback);
+    m_inputCallback = WTF::move(callback);
+    consumeReports();
+    registerDataReceivedCallbackInternal();
+}
+
+void HidConnection::unregisterDataReceivedCallback()
+{
+    m_inputCallback = nullptr;
+}
+
+void HidConnection::receiveReport(Vector<uint8_t>&& report)
+{
+    m_inputReports.append(WTF::move(report));
+    consumeReports();
+}
+
+void HidConnection::consumeReports()
+{
+    while (!m_inputReports.isEmpty() && m_inputCallback)
+        m_inputCallback(m_inputReports.takeFirst());
+}
+
+void HidConnection::registerDataReceivedCallbackInternal()
+{
+}
+
+}
+
+#endif

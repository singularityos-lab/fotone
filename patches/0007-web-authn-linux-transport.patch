+using SelectHook = void (*)(WebKitWebView*, const char* const* names, size_t count, IndexFunction, void*);
+
+template<typename T> static T hook(const char* name)
+{
+    return reinterpret_cast<T>(dlsym(RTLD_DEFAULT, name));
+}
+
+Ref<SintyAuthenticationPanelClient> SintyAuthenticationPanelClient::create(WebKitWebView* webView, API::WebAuthenticationPanel& panel)
+{
+    return adoptRef(*new SintyAuthenticationPanelClient(webView, panel));
+}
+
+SintyAuthenticationPanelClient::SintyAuthenticationPanelClient(WebKitWebView* webView, API::WebAuthenticationPanel& panel)
+    : m_webView(webView)
+    , m_panel(panel)
+{
+    auto begin = hook<BeginHook>("fotone_authenticator_begin");
+    if (!begin)
+        return;
+    begin(m_webView, panel.rpId().utf8().data(), panel.clientDataType() == WebCore::ClientDataType::Create, [](void* data) {
+        auto* client = static_cast<SintyAuthenticationPanelClient*>(data);
+        if (client->m_ended)
+            return;
+        if (RefPtr panel = client->m_panel.get())
+            panel->cancel();
+    }, this);
+}
+
+SintyAuthenticationPanelClient::~SintyAuthenticationPanelClient()
+{
+    end(false);
+}
+
+void SintyAuthenticationPanelClient::end(bool succeeded) const
+{
+    if (m_ended)
+        return;
+    m_ended = true;
+    if (auto end = hook<EndHook>("fotone_authenticator_end"))
+        end(m_webView, succeeded);
+}
+
+void SintyAuthenticationPanelClient::updatePanel(WebAuthenticationStatus status) const
+{
+    if (auto update = hook<UpdateHook>("fotone_authenticator_update"))
+        update(m_webView, static_cast<int>(status));
+}
+
+void SintyAuthenticationPanelClient::dismissPanel(WebAuthenticationResult result) const
+{
+    end(result == WebAuthenticationResult::Succeeded);
+}
+
+void SintyAuthenticationPanelClient::askPin(uint64_t retries, bool isNew, uint64_t minLength, CompletionHandler<void(const WTF::String&)>&& completionHandler) const
+{
+    auto ask = hook<PinHook>("fotone_authenticator_pin");
+    if (!ask) {
+        completionHandler(WTF::String());
+        return;
+    }
+    auto* pending = new CompletionHandler<void(const WTF::String&)>(WTF::move(completionHandler));
+    ask(m_webView, retries, isNew, minLength, [](void* data, const char* pin) {
+        std::unique_ptr<CompletionHandler<void(const WTF::String&)>> handler(static_cast<CompletionHandler<void(const WTF::String&)>*>(data));
+        (*handler)(pin ? WTF::String::fromUTF8(pin) : WTF::String());
+    }, pending);
+}
+
+void SintyAuthenticationPanelClient::requestPin(uint64_t retries, CompletionHandler<void(const WTF::String&)>&& completionHandler) const
+{
+    askPin(retries, false, 0, WTF::move(completionHandler));
+}
+
+void SintyAuthenticationPanelClient::requestNewPin(uint64_t minLength, CompletionHandler<void(const WTF::String&)>&& completionHandler) const
+{
+    askPin(0, true, minLength, WTF::move(completionHandler));
+}
+
+void SintyAuthenticationPanelClient::selectAssertionResponse(Vector<Ref<WebCore::AuthenticatorAssertionResponse>>&& responses, WebAuthenticationSource, CompletionHandler<void(WebCore::AuthenticatorAssertionResponse*)>&& completionHandler) const
+{
+    auto select = hook<SelectHook>("fotone_authenticator_select");
+    if (!select || responses.size() == 1) {
+        completionHandler(responses.isEmpty() ? nullptr : responses[0].ptr());
+        return;
+    }
+    struct Pending {
+        Vector<Ref<WebCore::AuthenticatorAssertionResponse>> responses;
+        CompletionHandler<void(WebCore::AuthenticatorAssertionResponse*)> handler;
+    };
+    Vector<CString> labels;
+    for (auto& response : responses)
+        labels.append((response->displayName().isEmpty() ? response->name() : response->displayName()).utf8());
+    Vector<const char*> names;
+    for (auto& label : labels)
+        names.append(label.data());
+    auto* pending = new Pending { WTF::move(responses), WTF::move(completionHandler) };
+    select(m_webView, names.span().data(), names.size(), [](void* data, int index) {
+        std::unique_ptr<Pending> pending(static_cast<Pending*>(data));
+        bool valid = index >= 0 && static_cast<size_t>(index) < pending->responses.size();
+        pending->handler(valid ? pending->responses[index].ptr() : nullptr);
+    }, pending);
+}
+
+}

+extern "C" {
+struct FotoneMediaEvents {
+    void* ctx;
+    void (*restart)(void*, uint64_t);
+    void (*frame)(void*);
+    void (*state)(void*, int64_t, int64_t, uint32_t);
+    void (*size)(void*, uint32_t, uint32_t);
+    void (*ended)(void*);
+    void (*failed)(void*, const char*);
+};
+typedef void (*FotoneMediaCopy)(void*, const uint8_t*, uint32_t, uint32_t, uint32_t, uint64_t);
+__attribute__((weak)) int fotone_media_available(void);
+__attribute__((weak)) FotoneMedia* fotone_media_open(uint64_t, const FotoneMediaEvents*);
+__attribute__((weak)) int fotone_media_feed(FotoneMedia*, uint64_t, const uint8_t*, size_t);
+__attribute__((weak)) void fotone_media_finish(FotoneMedia*, uint64_t);
+__attribute__((weak)) void fotone_media_control(FotoneMedia*, uint32_t, double);
+__attribute__((weak)) int fotone_media_frame(FotoneMedia*, FotoneMediaCopy, void*);
+__attribute__((weak)) void fotone_media_close(FotoneMedia*);
+}
+
+namespace WebCore {
+
+enum class SintyOp : uint32_t { Play = 1, Pause, Seek, Rate, Volume, Mute };
+static constexpr uint32_t sintyStatePlaying = 1;
+static constexpr uint32_t sintyStateSeekable = 2;
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(MediaPlayerPrivateSinty);
+
+using SintyWeak = ThreadSafeWeakPtr<MediaPlayerPrivateSinty>;
+
+class SintyMediaClient final : public PlatformMediaResourceClient {
+public:
+    static Ref<SintyMediaClient> create(MediaPlayerPrivateSinty& player, unsigned request, uint64_t offset)
+    {
+        return adoptRef(*new SintyMediaClient(player, request, offset));
+    }
+
+    void responseReceived(PlatformMediaResource&, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler) final
+    {
+        auto status = response.httpStatusCode();
+        bool failed = status >= 400;
+        std::optional<uint64_t> size;
+        if (status == 206) {
+            auto range = response.httpHeaderField(HTTPHeaderName::ContentRange);
+            auto slash = range.reverseFind('/');
+            if (slash != notFound)
+                size = parseInteger<uint64_t>(StringView(range).substring(slash + 1));
+        } else if (!failed) {
+            if (m_offset)
+                m_skip = m_offset;
+            if (response.expectedContentLength() > 0)
+                size = static_cast<uint64_t>(response.expectedContentLength());
+        }
+        if (RefPtr player = m_player.get())
+            player->responseArrived(m_request, size, failed);
+        completionHandler(failed ? ShouldContinuePolicyCheck::No : ShouldContinuePolicyCheck::Yes);
+    }
+
+    void dataReceived(PlatformMediaResource&, const SharedBuffer& buffer) final
+    {
+        auto data = buffer.span();
+        if (m_skip) {
+            auto drop = std::min<uint64_t>(m_skip, data.size());
+            data = data.subspan(drop);
+            m_skip -= drop;
+        }
+        if (data.empty())
+            return;
+        if (RefPtr player = m_player.get())
+            player->dataArrived(m_request, m_offset, data);
+        m_offset += data.size();
+    }
+
+    void accessControlCheckFailed(PlatformMediaResource&, const ResourceError&) final { finish(true); }
+    void loadFailed(PlatformMediaResource&, const ResourceError&) final { finish(true); }
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final { finish(false); }
+
+private:
+    SintyMediaClient(MediaPlayerPrivateSinty& player, unsigned request, uint64_t offset)
+        : m_player(player)
+        , m_request(request)
+        , m_offset(offset)
+    {
+    }
+
+    void finish(bool failed)
+    {
+        if (RefPtr player = m_player.get())
+            player->requestFinished(m_request, m_offset, failed);
+    }
+
+    SintyWeak m_player;
+    unsigned m_request;
+    uint64_t m_offset;
+    uint64_t m_skip { 0 };
+};
+
+MediaPlayerPrivateSinty::MediaPlayerPrivateSinty(MediaPlayer& player)
+    : m_player(player)
+{
+}
+
+MediaPlayerPrivateSinty::~MediaPlayerPrivateSinty()
+{
+    cancelLoad();
+}
+
+static SintyWeak* weakOf(void* ctx)
+{
+    return static_cast<SintyWeak*>(ctx);
+}
+
+template<typename Function>
+static void onMain(void* ctx, Function&& function)
+{
+    callOnMainThread([weak = *weakOf(ctx), function = WTF::move(function)]() mutable {
+        if (RefPtr player = weak.get())
+            function(*player);
+    });
+}
+
+void MediaPlayerPrivateSinty::onRestart(void* ctx, uint64_t offset)
+{
+    onMain(ctx, [offset](auto& player) { player.restartAt(offset); });
+}
+
+void MediaPlayerPrivateSinty::onFrame(void* ctx)
+{
+    onMain(ctx, [](auto& player) { player.frameArrived(); });
+}
+
+void MediaPlayerPrivateSinty::onState(void* ctx, int64_t position, int64_t duration, uint32_t flags)
+{
+    onMain(ctx, [position, duration, flags](auto& player) { player.stateArrived(position, duration, flags); });
+}
+
+void MediaPlayerPrivateSinty::onSize(void* ctx, uint32_t width, uint32_t height)
+{
+    onMain(ctx, [width, height](auto& player) { player.sizeArrived(width, height); });
+}
+
+void MediaPlayerPrivateSinty::onEnded(void* ctx)
+{
+    onMain(ctx, [](auto& player) { player.playbackEnded(); });
+}
+
+void MediaPlayerPrivateSinty::onFailed(void* ctx, const char*)
+{
+    onMain(ctx, [](auto& player) { player.failed(); });
+}
+
+void MediaPlayerPrivateSinty::load(const String& url)
+{
+    RefPtr player = m_player.get();
+    if (!player || !fotone_media_open) {
+        setNetworkState(MediaPlayer::NetworkState::FormatError);
+        return;
+    }
+    m_url = URL { url };
+    m_loader = player->mediaResourceLoader();
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    setReadyState(MediaPlayer::ReadyState::HaveNothing);
+    request(0);
+}
+
+#if ENABLE(MEDIA_SOURCE)
+void MediaPlayerPrivateSinty::load(const URL&, const LoadOptions&, MediaSourcePrivateClient&)
+{
+    setNetworkState(MediaPlayer::NetworkState::FormatError);
+}
+#endif
+
+#if ENABLE(MEDIA_STREAM)
+void MediaPlayerPrivateSinty::load(MediaStreamPrivate&)
+{
+    setNetworkState(MediaPlayer::NetworkState::FormatError);
+}
+#endif
+
+void MediaPlayerPrivateSinty::request(uint64_t offset)
+{
+    if (!m_loader)
+        return;
+    ResourceRequest request { URL { m_url } };
+    request.setAllowCookies(true);
+    if (RefPtr player = m_player.get())
+        request.setHTTPReferrer(player->referrer());
+#if USE(SOUP)
+    request.setAcceptEncoding(false);
+#endif
+    if (offset)
+        request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, offset, '-'));
+    m_request++;
+    m_resource = m_loader->requestResource(WTF::move(request), PlatformMediaResourceLoader::LoadOption::DisallowCaching);
+    if (!m_resource) {
+        failed();
+        return;
+    }
+    m_resource->setClient(SintyMediaClient::create(*this, m_request, offset));
+}
+
+void MediaPlayerPrivateSinty::stopRequest()
+{
+    m_request++;
+    if (RefPtr resource = std::exchange(m_resource, nullptr)) {
+        resource->setClient(nullptr);
+        resource->shutdown();
+    }
+}
+
+void MediaPlayerPrivateSinty::cancelLoad()
+{
+    stopRequest();
+    if (auto* media = std::exchange(m_media, nullptr))
+        fotone_media_close(media);
+    delete std::exchange(m_weak, nullptr);
+}
+
+void MediaPlayerPrivateSinty::restartAt(uint64_t offset)
+{
+    if (!m_media)
+        return;
+    stopRequest();
+    request(offset);
+}
+
+void MediaPlayerPrivateSinty::responseArrived(unsigned request, std::optional<uint64_t> size, bool failed)
+{
+    if (request != m_request)
+        return;
+    if (failed) {
+        this->failed();
+        return;
+    }
+    if (m_media)
+        return;
+    m_seekable = size.has_value();
+    auto* weak = new SintyWeak(*this);
+    FotoneMediaEvents events { weak, onRestart, onFrame, onState, onSize, onEnded, onFailed };
+    m_media = fotone_media_open(size.value_or(0), &events);
+    if (!m_media) {
+        delete weak;
+        setNetworkState(MediaPlayer::NetworkState::FormatError);
+        return;
+    }
+    m_weak = weak;
+}
+
+void MediaPlayerPrivateSinty::dataArrived(unsigned request, uint64_t offset, std::span<const uint8_t> data)
+{
+    if (request != m_request || !m_media)
+        return;
+    m_progress = true;
+    if (!fotone_media_feed(m_media, offset, data.data(), data.size()))
+        stopRequest();
+}
+
+void MediaPlayerPrivateSinty::requestFinished(unsigned request, uint64_t end, bool failed)
+{
+    if (request != m_request)
+        return;
+    m_resource = nullptr;
+    if (failed) {
+        this->failed();
+        return;
+    }
+    if (m_media)
+        fotone_media_finish(m_media, end);
+    if (m_hasMetadata && duration().isFinite())
+        m_buffered = PlatformTimeRanges { MediaTime::zeroTime(), duration() };
+    setNetworkState(MediaPlayer::NetworkState::Idle);
+}
+
+void MediaPlayerPrivateSinty::setNetworkState(MediaPlayer::NetworkState state)
+{
+    if (m_networkState == state)
+        return;
+    m_networkState = state;
+    if (RefPtr player = m_player.get())
+        player->networkStateChanged();
+}
+
+void MediaPlayerPrivateSinty::setReadyState(MediaPlayer::ReadyState state)
+{
+    if (m_readyState == state)
+        return;
+    m_readyState = state;
+    if (RefPtr player = m_player.get())
+        player->readyStateChanged();
+}
+
+void MediaPlayerPrivateSinty::stateArrived(int64_t position, int64_t duration, uint32_t flags)
+{
+    if (position >= 0) {
+        m_position = MediaTime(position, 1000000000);
+        m_positionAt = MonotonicTime::now();
+    }
+    m_playing = flags & sintyStatePlaying;
+    m_seekable = m_seekable || (flags & sintyStateSeekable);
+    if (duration > 0) {
+        auto value = MediaTime(duration, 1000000000);
+        bool changed = value != m_duration;
+        m_duration = value;
+        RefPtr player = m_player.get();
+        if (changed && player)
+            player->durationChanged();
+        if (!m_hasMetadata) {
+            m_hasMetadata = true;
+            if (player)
+                player->characteristicChanged();
+            setReadyState(MediaPlayer::ReadyState::HaveMetadata);
+            setReadyState(MediaPlayer::ReadyState::HaveEnoughData);
+        }
+    }
+}
+
+void MediaPlayerPrivateSinty::sizeArrived(unsigned width, unsigned height)
+{
+    m_size = FloatSize(width, height);
+    if (RefPtr player = m_player.get()) {
+        player->sizeChanged();
+        player->characteristicChanged();
+    }
+}
+
+void MediaPlayerPrivateSinty::frameArrived()
+{
+    m_imageStale = true;
+    if (RefPtr player = m_player.get())
+        player->repaint();
+}
+
+void MediaPlayerPrivateSinty::playbackEnded()
+{
+    m_ended = true;
+    m_paused = true;
+    m_playing = false;
+    if (m_duration.isValid())
+        m_position = m_duration;
+    if (RefPtr player = m_player.get()) {
+        player->timeChanged();
+        player->playbackStateChanged();
+    }
+}
+
+void MediaPlayerPrivateSinty::failed()
+{
+    stopRequest();
+    setNetworkState(m_hasMetadata ? MediaPlayer::NetworkState::DecodeError : MediaPlayer::NetworkState::FormatError);
+}
+
+void MediaPlayerPrivateSinty::play()
+{
+    if (!m_media)
+        return;
+    if (m_ended) {
+        fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Seek), 0);
+        m_position = MediaTime::zeroTime();
+        m_ended = false;
+    }
+    fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Play), 0);
+    m_paused = false;
+    m_positionAt = MonotonicTime::now();
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
+
+void MediaPlayerPrivateSinty::pause()
+{
+    m_position = currentTime();
+    m_positionAt = MonotonicTime::now();
+    m_paused = true;
+    m_playing = false;
+    if (m_media)
+        fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Pause), 0);
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
+
+MediaTime MediaPlayerPrivateSinty::duration() const
+{
+    return m_duration.isValid() ? m_duration : MediaTime::zeroTime();
+}
+
+MediaTime MediaPlayerPrivateSinty::currentTime() const
+{
+    auto time = m_position;
+    if (!m_paused && m_playing)
+        time += MediaTime::createWithDouble((MonotonicTime::now() - m_positionAt).seconds() * m_rate);
+    if (m_duration.isValid() && time > m_duration)
+        time = m_duration;
+    return time;
+}
+
+Ref<MediaTimePromise> MediaPlayerPrivateSinty::seekToTarget(const SeekTarget& target)
+{
+    m_position = target.time;
+    m_positionAt = MonotonicTime::now();
+    m_ended = false;
+    if (m_media)
+        fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Seek), target.time.toDouble());
+    return MediaTimePromise::createAndResolve(target.time);
+}
+
+void MediaPlayerPrivateSinty::setRateDouble(double rate)
+{
+    if (rate <= 0 || rate == m_rate)
+        return;
+    m_position = currentTime();
+    m_positionAt = MonotonicTime::now();
+    m_rate = rate;
+    if (m_media)
+        fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Rate), rate);
+    if (RefPtr player = m_player.get())
+        player->rateChanged();
+}
+
+void MediaPlayerPrivateSinty::setVolumeDouble(double volume)
+{
+    if (m_media)
+        fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Volume), volume);
+}
+
+void MediaPlayerPrivateSinty::setMuted(bool muted)
+{
+    if (m_media)
+        fotone_media_control(m_media, static_cast<uint32_t>(SintyOp::Mute), muted ? 1 : 0);
+}
+
+bool MediaPlayerPrivateSinty::didLoadingProgress() const
+{
+    return std::exchange(m_progress, false);
+}
+
+static void copyFrame(void* ctx, const uint8_t* pixels, uint32_t width, uint32_t height, uint32_t stride, uint64_t)
+{
+    auto info = SkImageInfo::Make(width, height, kBGRA_8888_SkColorType, kOpaque_SkAlphaType);
+    SkPixmap pixmap(info, pixels, stride);
+    *static_cast<RefPtr<NativeImage>*>(ctx) = NativeImage::create(SkImages::RasterFromPixmapCopy(pixmap));
+}
+
+RefPtr<NativeImage> MediaPlayerPrivateSinty::nativeImageForCurrentTime()
+{
+    if (m_imageStale && m_media) {
+        RefPtr<NativeImage> image;
+        if (fotone_media_frame(m_media, copyFrame, &image))
+            m_image = WTF::move(image);
+        m_imageStale = false;
+    }
+    return m_image;
+}
+
+void MediaPlayerPrivateSinty::paint(GraphicsContext& context, const FloatRect& rect)
+{
+    if (context.paintingDisabled())
+        return;
+    RefPtr image = nativeImageForCurrentTime();
+    if (!image)
+        return;
+    context.drawNativeImage(*image, rect, FloatRect { { }, image->size() });
+}
+
+DestinationColorSpace MediaPlayerPrivateSinty::colorSpace()
+{
+    return DestinationColorSpace::SRGB();
+}
+
+static bool sintyMediaAvailable()
+{
+    static bool available = [] {
+        if (const char* engine = getenv("FOTONE_MEDIA_ENGINE"); engine && !strcmp(engine, "gstreamer"))
+            return false;
+        return fotone_media_available && fotone_media_open && fotone_media_available();
+    }();
+    return available;
+}
+
+void MediaPlayerPrivateSinty::getSupportedTypes(HashSet<String>& types)
+{
+#if USE(GSTREAMER)
+    if (sintyMediaAvailable())
+        types = GStreamerRegistryScanner::singleton().mimeTypeSet(GStreamerRegistryScanner::Configuration::Decoding);
+#else
+    UNUSED_PARAM(types);
+#endif
+}
+
+MediaPlayer::SupportsType MediaPlayerPrivateSinty::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    if (parameters.platformType != PlatformMediaDecodingType::FileOrHLS || !sintyMediaAvailable())
+        return MediaPlayer::SupportsType::IsNotSupported;
+    auto container = parameters.type.containerType();
+    if (container.isEmpty() || equalLettersIgnoringASCIICase(container, "application/vnd.apple.mpegurl"_s) || equalLettersIgnoringASCIICase(container, "application/x-mpegurl"_s) || equalLettersIgnoringASCIICase(container, "audio/mpegurl"_s))
+        return MediaPlayer::SupportsType::IsNotSupported;
+#if USE(GSTREAMER)
+    return GStreamerRegistryScanner::singleton().isContentTypeSupported(GStreamerRegistryScanner::Configuration::Decoding, parameters.type, parameters.contentTypesRequiringHardwareSupport);
+#else
+    return MediaPlayer::SupportsType::MayBeSupported;
+#endif
+}
+
+class MediaPlayerFactorySinty final : public MediaPlayerFactory {
+    WTF_MAKE_TZONE_ALLOCATED(MediaPlayerFactorySinty);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(MediaPlayerFactorySinty);
+private:
+    MediaPlayerEnums::MediaEngineIdentifier identifier() const final { return MediaPlayerEnums::MediaEngineIdentifier::Sinty; }
+
+    Ref<MediaPlayerPrivateInterface> createMediaEnginePlayer(MediaPlayer& player) const final
+    {
+        return adoptRef(*new MediaPlayerPrivateSinty(player));
+    }
+
+    void getSupportedTypes(HashSet<String>& types) const final
+    {
+        MediaPlayerPrivateSinty::getSupportedTypes(types);
+    }
+
+    MediaPlayer::SupportsType supportsTypeAndCodecs(const MediaEngineSupportParameters& parameters) const final
+    {
+        return MediaPlayerPrivateSinty::supportsType(parameters);
+    }
+};
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(MediaPlayerFactorySinty);
+
+void MediaPlayerPrivateSinty::registerMediaEngine(MediaEngineRegistrar registrar)
+{
+    registrar(makeUnique<MediaPlayerFactorySinty>());
+}

+template<typename Factory, typename Codec>
+class FallbackVideoFactory final : public Factory {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(FallbackVideoFactory);
+public:
+    FallbackVideoFactory(std::unique_ptr<Factory>&& preferred, std::unique_ptr<Factory>&& fallback)
+        : m_preferred(WTF::move(preferred))
+        , m_fallback(WTF::move(fallback))
+    {
+    }
+
+    std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const final
+    {
+        auto formats = m_preferred->GetSupportedFormats();
+        for (auto& format : m_fallback->GetSupportedFormats()) {
+            if (!contains(formats, format))
+                formats.push_back(format);
+        }
+        return formats;
+    }
+
+    std::unique_ptr<Codec> Create(const webrtc::Environment& environment, const webrtc::SdpVideoFormat& format) final
+    {
+        if (contains(m_preferred->GetSupportedFormats(), format)) {
+            if (auto codec = m_preferred->Create(environment, format))
+                return codec;
+        }
+        return m_fallback->Create(environment, format);
+    }
+
+private:
+    static bool contains(const std::vector<webrtc::SdpVideoFormat>& formats, const webrtc::SdpVideoFormat& format)
+    {
+        return std::ranges::any_of(formats, [&](auto& candidate) { return candidate.IsSameCodec(format); });
+    }
+
+    std::unique_ptr<Factory> m_preferred;
+    std::unique_ptr<Factory> m_fallback;
+};
+

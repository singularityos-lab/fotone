+static gssize fotonePushStreamTake(FotonePushStream* stream, void* buffer, gsize count)
+{
+    gsize length = std::min<gsize>(count, stream->buffer->len);
+    memcpy(buffer, stream->buffer->data, length);
+    g_byte_array_remove_range(stream->buffer, 0, length);
+    return length;
+}
+
+static gssize fotonePushStreamRead(GInputStream* base, void* buffer, gsize count, GCancellable*, GError** error)
+{
+    auto* stream = reinterpret_cast<FotonePushStream*>(base);
+    g_mutex_lock(&stream->mutex);
+    while (!stream->buffer->len && !stream->finished)
+        g_cond_wait(&stream->cond, &stream->mutex);
+    gssize result = 0;
+    if (stream->buffer->len)
+        result = fotonePushStreamTake(stream, buffer, count);
+    else if (stream->error) {
+        g_set_error_literal(error, stream->error->domain, stream->error->code, stream->error->message);
+        result = -1;
+    }
+    g_mutex_unlock(&stream->mutex);
+    return result;
+}
+
+static void fotonePushStreamReadAsync(GInputStream* base, void* buffer, gsize count, int priority, GCancellable* cancellable, GAsyncReadyCallback callback, gpointer userData)
+{
+    auto* stream = reinterpret_cast<FotonePushStream*>(base);
+    GTask* task = g_task_new(base, cancellable, callback, userData);
+    g_task_set_priority(task, priority);
+    g_mutex_lock(&stream->mutex);
+    if (!stream->buffer->len && !stream->finished) {
+        stream->pending = task;
+        stream->pendingBuffer = buffer;
+        stream->pendingCount = count;
+        g_mutex_unlock(&stream->mutex);
+        return;
+    }
+    gssize result = 0;
+    GError* error = nullptr;
+    if (stream->buffer->len)
+        result = fotonePushStreamTake(stream, buffer, count);
+    else if (stream->error)
+        error = g_error_copy(stream->error);
+    g_mutex_unlock(&stream->mutex);
+    if (error)
+        g_task_return_error(task, error);
+    else
+        g_task_return_int(task, result);
+    g_object_unref(task);
+}
+
+static gssize fotonePushStreamReadFinish(GInputStream*, GAsyncResult* result, GError** error)
+{
+    return g_task_propagate_int(G_TASK(result), error);
+}
+
+static void fotonePushStreamWake(FotonePushStream* stream)
+{
+    g_mutex_lock(&stream->mutex);
+    GTask* task = nullptr;
+    gssize result = 0;
+    GError* error = nullptr;
+    if (stream->pending && (stream->buffer->len || stream->finished)) {
+        task = std::exchange(stream->pending, nullptr);
+        if (stream->buffer->len)
+            result = fotonePushStreamTake(stream, stream->pendingBuffer, stream->pendingCount);
+        else if (stream->error)
+            error = g_error_copy(stream->error);
+    }
+    g_cond_broadcast(&stream->cond);
+    g_mutex_unlock(&stream->mutex);
+    if (!task)
+        return;
+    if (error)
+        g_task_return_error(task, error);
+    else
+        g_task_return_int(task, result);
+    g_object_unref(task);
+}
+
+static void fotonePushStreamPush(GInputStream* base, const uint8_t* data, size_t length)
+{
+    auto* stream = reinterpret_cast<FotonePushStream*>(base);
+    g_mutex_lock(&stream->mutex);
+    if (!stream->finished)
+        g_byte_array_append(stream->buffer, data, length);
+    g_mutex_unlock(&stream->mutex);
+    fotonePushStreamWake(stream);
+}
+
+static void fotonePushStreamFinish(GInputStream* base, GError* error)
+{
+    auto* stream = reinterpret_cast<FotonePushStream*>(base);
+    g_mutex_lock(&stream->mutex);
+    if (stream->finished) {
+        g_mutex_unlock(&stream->mutex);
+        if (error)
+            g_error_free(error);
+        return;
+    }
+    stream->finished = TRUE;
+    stream->error = error;
+    g_mutex_unlock(&stream->mutex);
+    fotonePushStreamWake(stream);
+}
+
+static void fotonePushStreamFinalize(GObject* object)
+{
+    auto* stream = reinterpret_cast<FotonePushStream*>(object);
+    g_byte_array_unref(stream->buffer);
+    if (stream->error)
+        g_error_free(stream->error);
+    g_mutex_clear(&stream->mutex);
+    g_cond_clear(&stream->cond);
+    G_OBJECT_CLASS(fotone_push_stream_parent_class)->finalize(object);
+}
+
+static void fotone_push_stream_init(FotonePushStream* stream)
+{
+    g_mutex_init(&stream->mutex);
+    g_cond_init(&stream->cond);
+    stream->buffer = g_byte_array_new();
+}
+
+static void fotone_push_stream_class_init(FotonePushStreamClass* klass)
+{
+    G_OBJECT_CLASS(klass)->finalize = fotonePushStreamFinalize;
+    auto* streamClass = G_INPUT_STREAM_CLASS(klass);
+    streamClass->read_fn = fotonePushStreamRead;
+    streamClass->read_async = fotonePushStreamReadAsync;
+    streamClass->read_finish = fotonePushStreamReadFinish;
+}

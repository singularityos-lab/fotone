+    RefPtr<NetworkDataTaskSoup> protectedThis(this);
+    m_http3Failed = true;
+    stopHTTP3(nullptr);
+    m_http3Stream = nullptr;
+    m_networkLoadMetrics = { };
+    if (m_state != State::Canceling && m_state != State::Completed)
+        sendSoupRequest();

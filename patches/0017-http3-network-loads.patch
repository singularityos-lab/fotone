+
+void NetworkDataTaskSoup::didReceiveHTTP3Response(std::span<const char> block)
+{
+    if (m_state == State::Canceling || m_state == State::Completed || !m_soupMessage)
+        return;
+    Vector<std::pair<CString, CString>> fields;
+    int status = 0;
+    size_t offset = 0;
+    while (offset < block.size()) {
+        auto rest = block.subspan(offset);
+        size_t nameLength = strnlen(rest.data(), rest.size());
+        if (nameLength + 1 >= rest.size())
+            break;
+        auto valueSpan = rest.subspan(nameLength + 1);
+        size_t valueLength = strnlen(valueSpan.data(), valueSpan.size());
+        CString name(std::span<const char>(rest.data(), nameLength));
+        CString value(std::span<const char>(valueSpan.data(), valueLength));
+        offset += nameLength + valueLength + 2;
+        if (!strcmp(name.data(), ":status"))
+            status = atoi(value.data());
+        else if (name.length() && name.data()[0] != ':')
+            fields.append({ WTF::move(name), WTF::move(value) });
+    }
+    if (status < 200 || (status >= 300 && status < 400) || status == 401 || status == 407 || status == 421) {
+        fallBackFromHTTP3();
+        return;
+    }
+
+    auto* message = m_soupMessage.get();
+    auto* uri = soup_message_get_uri(message);
+    auto* jar = cookieJarFor(static_cast<NetworkSessionSoup&>(*m_session).soupSession(), message);
+    String contentType;
+    String contentEncoding;
+    long long contentLength = -1;
+    for (auto& field : fields) {
+        if (!strcmp(field.first.data(), "content-type"))
+            contentType = String::fromUTF8(field.second.data());
+        else if (!strcmp(field.first.data(), "content-encoding"))
+            contentEncoding = String::fromUTF8(field.second.data());
+        else if (!strcmp(field.first.data(), "content-length"))
+            contentLength = g_ascii_strtoll(field.second.data(), nullptr, 10);
+        else if (!strcmp(field.first.data(), "set-cookie") && jar) {
+            if (auto* cookie = soup_cookie_parse(field.second.data(), uri))
+                soup_cookie_jar_add_cookie_full(jar, cookie, uri, soup_message_get_first_party(message));
+        } else if (!strcmp(field.first.data(), "alt-svc") && fotone_h3_learn)
+            fotone_h3_learn(g_uri_get_host(uri), g_uri_get_port(uri) > 0 ? g_uri_get_port(uri) : 443, field.second.data());
+    }
+
+    GRefPtr<GInputStream> body = m_http3Stream;
+    if (equalLettersIgnoringASCIICase(contentEncoding, "gzip"_s)) {
+        GRefPtr<GConverter> decompressor = adoptGRef(G_CONVERTER(g_zlib_decompressor_new(G_ZLIB_COMPRESSOR_FORMAT_GZIP)));
+        body = adoptGRef(g_converter_input_stream_new(m_http3Stream.get(), decompressor.get()));
+        contentLength = -1;
+    } else if (!contentEncoding.isEmpty() && !equalLettersIgnoringASCIICase(contentEncoding, "identity"_s)) {
+        fallBackFromHTTP3();
+        return;
+    }
+
+    URL url = m_currentRequest.url();
+    String mimeType = extractMIMETypeFromMediaType(contentType);
+    if (mimeType.isEmpty())
+        mimeType = MIMETypeRegistry::mimeTypeForPath(url.path());
+    ResourceResponse response(URL(url), WTF::move(mimeType), contentLength, extractCharsetFromMediaType(contentType).toString());
+    response.setHTTPStatusCode(status);
+    response.setHTTPVersion("HTTP/3"_s);
+    for (auto& field : fields)
+        response.addHTTPHeaderField(String::fromUTF8(field.first.data()), String::fromUTF8(field.second.data()));
+
+    m_networkLoadMetrics.responseStart = MonotonicTime::now();
+    m_networkLoadMetrics.protocol = "h3"_s;
+    m_response = WTF::move(response);
+    m_inputStream = WTF::move(body);
+    m_http3Responded = true;
+    if (m_state == State::Suspended) {
+        m_http3PendingResponse = true;
+        return;
+    }
+    dispatchDidReceiveResponse();
+}
+
+void NetworkDataTaskSoup::didCompleteHTTP3(bool ok)
+{
+    RefPtr<NetworkDataTaskSoup> protectedThis(this);
+    void* handle = std::exchange(m_http3, nullptr);
+    if (!handle)
+        return;
+    if (fotone_h3_release)
+        fotone_h3_release(handle);
+    deref();
+    if (!m_http3Responded) {
+        if (m_state != State::Canceling && m_state != State::Completed) {
+            m_http3Failed = true;
+            m_http3Stream = nullptr;
+            m_networkLoadMetrics = { };
+            sendSoupRequest();
+        }
+        return;
+    }
+    m_networkLoadMetrics.responseEnd = MonotonicTime::now();
+    m_networkLoadMetrics.markComplete();
+    if (m_http3Stream)
+        fotonePushStreamFinish(m_http3Stream.get(), ok ? nullptr : g_error_new_literal(G_IO_ERROR, G_IO_ERROR_CONNECTION_CLOSED, "HTTP/3 stream closed"));
+}

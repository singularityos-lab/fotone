+void NetworkDataTaskSoup::stopHTTP3(GError* error)
+{
+    if (m_http3Stream)
+        fotonePushStreamFinish(m_http3Stream.get(), error);
+    else if (error)
+        g_error_free(error);
+    if (!m_http3)
+        return;
+    void* handle = std::exchange(m_http3, nullptr);
+    if (fotone_h3_cancel)
+        fotone_h3_cancel(handle);
+    if (fotone_h3_release)
+        fotone_h3_release(handle);
+    deref();
+}

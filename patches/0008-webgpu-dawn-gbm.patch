+#if USE(GBM)
+static uint32_t fourccForTextureFormat(TextureFormat textureFormat)
+{
+    switch (textureFormat) {
+    case TextureFormat::Rgba8unorm:
+    case TextureFormat::Rgba8unormSRGB:
+        return DRM_FORMAT_ABGR8888;
+    case TextureFormat::Rgba16float:
+        return DRM_FORMAT_ABGR16161616F;
+    default:
+        return DRM_FORMAT_ARGB8888;
+    }
+}
+
+static uint64_t nextRenderBufferID()
+{
+    static std::atomic<uint64_t> lastID { 0 };
+    return ++lastID;
+}
+
+static std::optional<DMABufBufferAttributes> duplicateAttributes(const DMABufBufferAttributes& attributes)
+{
+    DMABufBufferAttributes copy;
+    copy.size = attributes.size;
+    copy.fourcc = attributes.fourcc;
+    copy.offsets = attributes.offsets;
+    copy.strides = attributes.strides;
+    copy.modifier = attributes.modifier;
+    for (auto& fd : attributes.fds) {
+        auto duplicate = fd.duplicate();
+        if (!duplicate)
+            return std::nullopt;
+        copy.fds.append(WTF::move(duplicate));
+    }
+    return copy;
+}
+
+bool CompositorIntegrationImpl::recreateRenderBuffers(int width, int height, WebCore::DestinationColorSpace&&, WebCore::AlphaPremultiplication, TextureFormat textureFormat, unsigned bufferCount, Device& device)
+{
+    m_renderBuffers.clear();
+    m_device = device;
+
+    if (RefPtr presentationContext = m_presentationContext) {
+        static_cast<PresentationContext*>(presentationContext.get())->unconfigure();
+        presentationContext->setSize(width, height);
+    }
+
+    constexpr int max2DTextureSize = 16384;
+    width = std::max(1, std::min(max2DTextureSize, width));
+    height = std::max(1, std::min(max2DTextureSize, height));
+
+    auto gbmDevice = DRMDeviceManager::singleton().mainGBMDevice(DRMDeviceManager::NodeType::Render);
+    if (gbmDevice) {
+        auto fourcc = fourccForTextureFormat(textureFormat);
+        for (unsigned bufferIndex = 0; bufferIndex < std::min<unsigned>(3u, bufferCount); ++bufferIndex) {
+            auto* bo = gbm_bo_create(gbmDevice->device(), width, height, fourcc, GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+            if (!bo)
+                break;
+            auto attributes = DMABufBufferAttributes::fromGBMBufferObject(bo);
+            gbm_bo_destroy(bo);
+            if (!attributes || attributes->fds.size() > 4)
+                break;
+            if (attributes->modifier == DRM_FORMAT_MOD_INVALID)
+                attributes->modifier = DRM_FORMAT_MOD_LINEAR;
+            m_renderBuffers.append({ nextRenderBufferID(), WTF::move(*attributes), false });
+        }
+    }
+
+    Vector<WGPUDmaBuf> buffers;
+    for (auto& renderBuffer : m_renderBuffers) {
+        auto& attributes = renderBuffer.attributes;
+        WGPUDmaBuf buffer { };
+        buffer.width = attributes.size.width();
+        buffer.height = attributes.size.height();
+        buffer.fourcc = attributes.fourcc.value;
+        buffer.modifier = attributes.modifier;
+        buffer.planeCount = attributes.fds.size();
+        for (size_t plane = 0; plane < attributes.fds.size(); ++plane)
+            buffer.planes[plane] = { attributes.fds[plane].value(), attributes.offsets[plane], attributes.strides[plane] };
+        buffers.append(buffer);
+    }
+
+    WGPUDmaBufArray array { buffers.size(), buffers.span().data() };
+    if (m_renderBuffersWereRecreatedCallback)
+        m_renderBuffersWereRecreatedCallback(&array);
+
+    return !m_renderBuffers.isEmpty();
+}
+
+void CompositorIntegrationImpl::prepareForDisplay(uint32_t frameIndex, DisplayBufferHandler&& completionHandler)
+{
+    RefPtr presentationContext = m_presentationContext;
+    if (!presentationContext || m_renderBuffers.isEmpty())
+        return completionHandler(0, std::nullopt, { });
+
+    presentationContext->present(frameIndex);
+    auto fence = presentationContext->takeFence();
+
+    auto& renderBuffer = m_renderBuffers[frameIndex % m_renderBuffers.size()];
+    std::optional<DMABufBufferAttributes> attributes;
+    if (!renderBuffer.sent) {
+        attributes = duplicateAttributes(renderBuffer.attributes);
+        renderBuffer.sent = !!attributes;
+    }
+
+    m_onSubmittedWorkScheduledCallback([completionHandler = WTF::move(completionHandler), id = renderBuffer.id, attributes = WTF::move(attributes), fence = WTF::move(fence)]() mutable {
+        completionHandler(id, WTF::move(attributes), WTF::move(fence));
+    });
+}

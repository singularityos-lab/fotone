+#include "config.h"
+#include "GPUCanvasContextGBM.h"
+
+#if HAVE(WEBGPU_IMPLEMENTATION) && USE(GBM)
+
+#include "CoordinatedPlatformLayerBufferDMABuf.h"
+#include "DMABufBuffer.h"
+#include "DestinationColorSpace.h"
+#include "GPU.h"
+#include "GPUDevice.h"
+#include "GPUPresentationContextDescriptor.h"
+#include "GPUTextureFormat.h"
+#include "GraphicsLayerContentsDisplayDelegateCoordinated.h"
+#include "HTMLCanvasElement.h"
+#include "OffscreenCanvas.h"
+#include "TextureMapperFlags.h"
+#include <wtf/TZoneMallocInlines.h>
+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(GPUCanvasContextGBM);
+
+static constexpr unsigned renderBufferCount = 3;
+
+static bool isSupportedFormat(GPUTextureFormat format)
+{
+    return format == GPUTextureFormat::Bgra8unorm || format == GPUTextureFormat::Rgba8unorm || format == GPUTextureFormat::Rgba16float;
+}
+
+std::unique_ptr<GPUCanvasContext> GPUCanvasContext::create(CanvasBase& canvas, GPU& gpu, Document*)
+{
+    RefPtr compositorIntegration = gpu.createCompositorIntegration();
+    if (!compositorIntegration)
+        return nullptr;
+
+    RefPtr presentationContext = gpu.createPresentationContext({ *compositorIntegration });
+    if (!presentationContext)
+        return nullptr;
+
+    std::unique_ptr<GPUCanvasContextGBM> context { new GPUCanvasContextGBM(canvas, compositorIntegration.releaseNonNull(), presentationContext.releaseNonNull()) };
+    context->suspendIfNeeded();
+    return context;
+}
+
+GPUCanvasContextGBM::GPUCanvasContextGBM(CanvasBase& canvas, Ref<GPUCompositorIntegration>&& compositorIntegration, Ref<GPUPresentationContext>&& presentationContext)
+    : GPUCanvasContext(canvas)
+    , m_layerContentsDisplayDelegate(GraphicsLayerContentsDisplayDelegateCoordinated::create())
+    , m_compositorIntegration(WTF::move(compositorIntegration))
+    , m_presentationContext(WTF::move(presentationContext))
+{
+}
+
+GPUCanvasContextGBM::~GPUCanvasContextGBM() = default;
+
+GPUCanvasContext::CanvasType GPUCanvasContextGBM::canvas()
+{
+    Ref base = canvasBase();
+#if ENABLE(OFFSCREEN_CANVAS)
+    if (RefPtr offscreen = dynamicDowncast<OffscreenCanvas>(base.get()))
+        return offscreen.releaseNonNull();
+#endif
+    return downcast<HTMLCanvasElement>(base.get());
+}
+
+RefPtr<GraphicsLayerContentsDisplayDelegate> GPUCanvasContextGBM::layerContentsDisplayDelegate()
+{
+    return m_layerContentsDisplayDelegate.copyRef();
+}
+
+PixelFormat GPUCanvasContextGBM::pixelFormat() const
+{
+#if ENABLE(PIXEL_FORMAT_RGBA16F)
+    if (m_configuration && m_configuration->format == GPUTextureFormat::Rgba16float)
+        return PixelFormat::RGBA16F;
+#endif
+    return isOpaque() ? PixelFormat::BGRX8 : PixelFormat::BGRA8;
+}
+
+bool GPUCanvasContextGBM::isOpaque() const
+{
+    return !m_configuration || m_configuration->alphaMode == GPUCanvasAlphaMode::Opaque;
+}
+
+ExceptionOr<void> GPUCanvasContextGBM::configure(GPUCanvasConfiguration&& configuration)
+{
+    if (!isSupportedFormat(configuration.format))
+        return Exception { ExceptionCode::TypeError, "GPUCanvasContext.configure: the canvas format must be bgra8unorm, rgba8unorm or rgba16float."_s };
+
+    auto size = canvasBase().size();
+    m_width = std::max(1, size.width());
+    m_height = std::max(1, size.height());
+
+    auto alphaMode = configuration.alphaMode == GPUCanvasAlphaMode::Opaque ? AlphaPremultiplication::Unpremultiplied : AlphaPremultiplication::Premultiplied;
+    auto colorSpace = DestinationColorSpace::SRGB();
+    if (!m_compositorIntegration->recreateRenderBuffers(m_width, m_height, WTF::move(colorSpace), alphaMode, convertToBacking(configuration.format), renderBufferCount, configuration.device->backing()))
+        return Exception { ExceptionCode::OperationError, "GPUCanvasContext.configure: the canvas buffers could not be allocated."_s };
+
+    m_currentTexture = nullptr;
+    m_displayBuffers.clear();
+    if (!m_presentationContext->configure(configuration, m_width, m_height, true))
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.configure: the presentation context could not be configured."_s };
+
+    m_configuration = WTF::move(configuration);
+    markContextChangedAndNotifyCanvasObservers();
+    return { };
+}
+
+void GPUCanvasContextGBM::unconfigure()
+{
+    m_presentationContext->unconfigure();
+    m_configuration = std::nullopt;
+    m_currentTexture = nullptr;
+    m_displayBuffers.clear();
+}
+
+std::optional<GPUCanvasConfiguration> GPUCanvasContextGBM::getConfiguration() const
+{
+    if (!m_configuration)
+        return std::nullopt;
+    return GPUCanvasConfiguration { m_configuration->device.copyRef(), m_configuration->format, m_configuration->usage, m_configuration->viewFormats, m_configuration->colorSpace, m_configuration->toneMapping, m_configuration->alphaMode };
+}
+
+ExceptionOr<Ref<GPUTexture>> GPUCanvasContextGBM::getCurrentTexture()
+{
+    if (!m_configuration)
+        return Exception { ExceptionCode::InvalidStateError, "GPUCanvasContext.getCurrentTexture: the canvas is not configured."_s };
+
+    if (!m_currentTexture) {
+        m_currentTexture = m_presentationContext->getCurrentTexture(m_frameIndex);
+        markContextChangedAndNotifyCanvasObservers();
+    }
+
+    if (!m_currentTexture)
+        return Exception { ExceptionCode::OperationError, "GPUCanvasContext.getCurrentTexture: no texture is available."_s };
+    return Ref { *m_currentTexture };
+}
+
+void GPUCanvasContextGBM::didUpdateCanvasSizeProperties(bool sizeChanged)
+{
+    if (!sizeChanged || !m_configuration)
+        return;
+
+    auto configuration = getConfiguration();
+    auto result = configure(WTF::move(*configuration));
+    UNUSED_VARIABLE(result);
+}
+
+void GPUCanvasContextGBM::markContextChangedAndNotifyCanvasObservers()
+{
+    m_compositingResultsNeedsUpdating = true;
+    markCanvasChanged();
+}
+
+void GPUCanvasContextGBM::prepareForDisplay()
+{
+    if (!m_configuration || !m_compositingResultsNeedsUpdating)
+        return;
+
+    auto frameIndex = m_frameIndex;
+    m_compositorIntegration->prepareForDisplay(frameIndex, WebGPU::CompositorIntegration::DisplayBufferHandler { [this](uint64_t bufferID, std::optional<DMABufBufferAttributes>&& attributes, UnixFileDescriptor&& fence) {
+        setDisplayBuffer(bufferID, WTF::move(attributes), WTF::move(fence));
+    } });
+    m_presentationContext->present(frameIndex);
+    m_currentTexture = nullptr;
+    m_frameIndex = (m_frameIndex + 1) % renderBufferCount;
+    m_compositingResultsNeedsUpdating = false;
+}
+
+void GPUCanvasContextGBM::setDisplayBuffer(uint64_t bufferID, std::optional<DMABufBufferAttributes>&& attributes, UnixFileDescriptor&& fence)
+{
+    if (!bufferID)
+        return;
+
+    RefPtr<DMABufBuffer> buffer;
+    if (attributes) {
+        m_displayBuffers.removeAllMatching([&](auto& existing) {
+            return existing->id() == bufferID;
+        });
+        buffer = DMABufBuffer::create(bufferID, WTF::move(*attributes));
+        m_displayBuffers.append(*buffer);
+        if (m_displayBuffers.size() > renderBufferCount)
+            m_displayBuffers.removeAt(0);
+    } else {
+        for (auto& existing : m_displayBuffers) {
+            if (existing->id() == bufferID)
+                buffer = existing.ptr();
+        }
+    }
+
+    if (!buffer)
+        return;
+
+    OptionSet<TextureMapperFlags> flags;
+    if (!isOpaque())
+        flags.add(TextureMapperFlags::ShouldBlend);
+    Ref<GraphicsLayerContentsDisplayDelegate> delegate = m_layerContentsDisplayDelegate;
+    delegate->setDisplayBuffer(CoordinatedPlatformLayerBufferDMABuf::create(buffer.releaseNonNull(), flags, WTF::move(fence)));
+}
+
+}
